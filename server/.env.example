# 511 open data token — request at https://511.org/open-data/
FIVE11_API_KEY=

# Which agencies this deployment runs, by id from server/agencies.json.
# One poll loop per id. Empty = sf only (the historical single-agency setup).
SERVED_AGENCIES=sf

# Upstream poll interval PER AGENCY, in seconds. Pick a value that keeps
# (number of agencies) * 3600 / POLL_SECONDS under your token cap — 511's
# default token is 60 req/hour, so two agencies at 65s (110 req/h) is over
# it and two agencies at 125s (57.6 req/h) is not. The server logs a warning
# at startup when the total would exceed the default token, but your setting
# always wins.
POLL_SECONDS=65

# TriMet (Portland): the realtime feeds require a self-service AppID, free
# at https://developer.trimet.org/appid (allowance: 1,000,000 requests per
# AppID per day). The registry entry names this variable
# ("api_key_env": "TRIMET_APPID") and the query parameter ("appID") its
# value rides under; the proxy appends it to every feed request. TriMet's
# static GTFS zip needs no key.
# TRIMET_APPID=

# WMATA (Washington Metrorail): every GTFS endpoint is keyed — the rail
# VehiclePositions feed AND the rail static zip. Register free at
# https://developer.wmata.com/ and subscribe to the Default tier (10
# requests/second, 50,000/day). The registry entry names this variable
# ("api_key_env": "WMATA_API_KEY") and the query parameter ("api_key").
# WMATA's public use key is for testing only (their terms, section 4).
# Note their terms also restrict re-serving the data through your own API
# to third parties without written authorization — see
# docs/wmata-feasibility.md before exposing this agency on a shared proxy.
# WMATA_API_KEY=

HOST=0.0.0.0
PORT=8000
