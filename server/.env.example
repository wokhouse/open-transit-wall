# 511 open data token — request at https://511.org/open-data/
FIVE11_API_KEY=

# 60s is 511's default token limit (60 req/hour); the startup GTFS refresh
# makes it one extra request, so 65s keeps a live run under the cap.
POLL_SECONDS=65

# Which vehicle classes to show: subset of B(bus) R(rapid) M(metro) C(cable),
# comma-separated ("M,C") or run together ("MC"). Empty = all.
TYPES=

HOST=0.0.0.0
PORT=8000
